# VYTRON AIOps — Environment Variables
# Copy this to .env and fill in your values.

# API key for collector-to-backend authentication
COLLECTOR_API_KEY=vytron-collector-key-2026

# Tenant and collector identifiers
TENANT_ID=TENANT-01
COLLECTOR_ID=COLLECTOR-01

# Service URLs
BACKEND_URL=http://localhost:8000
COLLECTOR_URL=http://localhost:8002
SIMULATOR_URL=http://localhost:8001

# LLM Configuration
# Provider: "ollama" | "gemini" | "openai"
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
# For Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
# For hosted providers (uncomment and set)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key

# Google OAuth 2.0 / OpenID Connect Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000
SESSION_SECRET=vytron-secure-session-secret-change-in-production

# Comma-separated list of pre-authorized administrator Google email addresses
INITIAL_ADMIN_EMAILS=admin@vytron.ai,shreesh107@gmail.com
