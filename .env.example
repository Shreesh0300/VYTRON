# CICADA AIOps — Environment Variables
# Copy this to .env and fill in your values.

# API key for collector-to-backend authentication
COLLECTOR_API_KEY=cicada-collector-key-2026

# Tenant and collector identifiers
TENANT_ID=TENANT-01
COLLECTOR_ID=COLLECTOR-01

# Service URLs
BACKEND_URL=http://localhost:8000
COLLECTOR_URL=http://localhost:8002
SIMULATOR_URL=http://localhost:8001

# LLM Configuration
# Provider: "ollama" | "gemini" | "openai"
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
# For Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
# For hosted providers (uncomment and set)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
